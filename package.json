{
  "name": "@cryptonly/medusa-plugin-cryptonly",
  "version": "0.1.4",
  "description": "Official Cryptonly payment provider for Medusa v2.",
  "author": "Cryptonly",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cryptonly-net/cryptonly-medusa.git"
  },
  "bugs": {
    "url": "https://github.com/cryptonly-net/cryptonly-medusa/issues"
  },
  "homepage": "https://cryptonly.net",
  "keywords": [
    "medusa-plugin",
    "medusa-plugin-integration",
    "medusa-plugin-payment",
    "medusa-v2",
    "cryptonly",
    "crypto",
    "payments"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    ".medusa/server",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    },
    "./*": "./.medusa/server/src/*.js"
  },
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "typecheck": "tsc --noEmit",
    "test:utils": "ts-node --transpile-only scripts/utils.selftest.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@cryptonly/sdk": "^1.2.0"
  },
  "peerDependencies": {
    "@medusajs/framework": ">=2.8.0 <3.0.0"
  },
  "devDependencies": {
    "@medusajs/cli": "2.18.0",
    "@medusajs/framework": "2.18.0",
    "@medusajs/medusa": "2.18.0",
    "@swc/core": "^1.7.28",
    "@types/node": "^20.12.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
