{
  "name": "@cryptonly/medusa-dev-store",
  "version": "0.0.1",
  "private": true,
  "description": "Local Medusa harness for developing @cryptonly/medusa-plugin-cryptonly",
  "license": "MIT",
  "scripts": {
    "build": "medusa build",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "start": "medusa start",
    "dev": "medusa develop",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "medusa db:migrate",
    "setup": "bash ./scripts/setup.sh",
    "link-plugin": "bash ./scripts/link-plugin.sh",
    "tunnel": "bash ./scripts/set-tunnel-url.sh"
  },
  "dependencies": {
    "@cryptonly/medusa-plugin-cryptonly": "file:.yalc/@cryptonly/medusa-plugin-cryptonly",
    "@medusajs/admin-sdk": "2.18.0",
    "@medusajs/cli": "2.18.0",
    "@medusajs/framework": "2.18.0",
    "@medusajs/medusa": "2.18.0"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.18.0",
    "@swc/core": "^1.7.28",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.14",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20"
  }
}
